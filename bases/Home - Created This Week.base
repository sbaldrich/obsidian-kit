filters:
  and:
    - file.ctime.format("GGGG-WW") == today().format("GGGG-WW")
    - '!file.name.contains("Template")'
formulas:
  noteName: link(file.name, file.name.replace(/^\d{4} - /, ""))
properties:
  formula.noteName:
    displayName: Note
  file.ctime:
    displayName: Created
  category:
    displayName: Category
  tags:
    displayName: Tags
views:
  - type: table
    name: Created This Week
    filters:
      and:
        - '!file.tags.containsAny("daily")'
    order:
      - formula.noteName
      - file.ctime
      - category
      - tags
    sort:
      - property: file.ctime
        direction: DESC
    limit: 12
    columnSize:
      formula.noteName: 322
      file.ctime: 172
