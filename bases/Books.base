filters:
  and:
    - category == "Books"
    - not:
        - file.name.contains("Template")
formulas:
  rating: |
    if(rating, '⭐'.repeat(rating).split('').map(icon('star'))
    , null)
properties:
  formula.rating:
    displayName: rating
views:
  - type: cards
    name: Cards
    order:
      - file.name
      - status
      - formula.rating
      - author
    sort:
      - property: rating
        direction: DESC
    image: cover
    imageAspectRatio: 1
    imageFit: contain
    cardSize: 150
  - type: table
    name: List
    order:
      - file.name
      - file.ctime.date()
