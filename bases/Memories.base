filters:
  and:
    - category.contains("Memories")
properties:
  file.name:
    displayName: Memory
  created:
    displayName: Written
  start:
    displayName: When
  people:
    displayName: People
views:
  - type: table
    name: All Memories
    order:
      - file.name
      - created
      - start
      - people
    sort:
      - property: created
        direction: DESC
  - type: table
    name: By Person
    filters:
      or:
        - people.contains(this.file.name)
    order:
      - file.name
      - created
      - start
    sort:
      - property: created
        direction: DESC
