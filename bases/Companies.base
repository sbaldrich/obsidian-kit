filters:
  and:
    - category.contains("Companies")
views:
  - type: table
    name: Notes
    filters:
      or:
        - this.file.tags.contains('categories')
        - companies.contains(this.file.name)
    order:
      - file.name
      - link
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 239
