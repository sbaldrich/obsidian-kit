filters:
  and:
    - category == "[[Financial Transactions]]"
    - not:
        - file.name.contains("Template")
formulas:
  statusIcon: |
    if(status == 'cleared', icon('circle-check'),
       if(status == 'reconciled', icon('circle-check-big'),
          if(status == 'pending', icon('circle-dashed'),
             status)))
  link: link(file.name, date.format("MM-DD"))
  year: date.format("YYYY")
properties:
  formula.statusIcon:
    displayName: Status
  formula.link:
    displayName: id
views:
  - type: table
    name: All Transactions
    filters:
      or:
        - this.file.tags.contains('categories')
        - parents.contains(this.file.name)
    groupBy:
      property: formula.year
      direction: DESC
    order:
      - formula.link
      - date
      - amount
      - currency
      - type
    sort:
      - property: date
        direction: ASC
      - property: id
        direction: ASC
    columnSize:
      formula.link: 61
  - type: table
    name: Loans
    filters:
      and:
        - or:
            - this.file.tags.contains('categories')
            - parents.contains(this.file.name)
        - and:
            - type == "loan"
    groupBy:
      property: formula.year
      direction: ASC
    order:
      - formula.link
      - date
      - amount
      - currency
      - concept
    sort:
      - property: date
        direction: ASC
      - property: id
        direction: ASC
