filters:
  and:
    - file.ctime.format("GGGG") == this.year.toString()
    - file.ctime.format("WW") == this.week.toString()
    - '!file.hasTag("daily")'
    - '!file.hasTag("monthly")'
    - '!file.hasTag("weekly")'
    - '!file.hasTag("weekly-plan")'
properties:
  file.name:
    displayName: Entry
  category:
    displayName: Categories
  tags:
    displayName: Tags
views:
  - type: table
    name: Weekly notes
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - tags
    sort:
      - property: file.name
        direction: ASC
      - property: category
        direction: ASC
