filters:
  and:
    - or:
        - file.tags.contains('task')
        - category == 'Tasks'
    - or:
        - companies.contains(this.file.name)
        - parents.contains(this.file.name)
        - project.contains(this.file.name)
        - project == this.file.name
views:
  - type: table
    name: All notes
    filters:
      or:
        - this.controls.status == null
        - this.controls.status == status
        - this.controls.status == 'any'
    order:
      - created
      - file.name
      - status
    sort:
      - property: created
        direction: DESC
      - property: start
        direction: DESC
    columnSize:
      file.name: 237
