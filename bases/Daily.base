filters:
  or:
    - file.name.contains(this.file.name)
    - created.toString().contains(this.file.name)
    - start.toString().contains(this.file.name)
    - end.toString().contains(this.file.name)
    - file.links.contains(this.file)
properties:
  file.name:
    displayName: Entry
  note.category:
    displayName: Categories
  note.created:
    displayName: Created
  note.start:
    displayName: Created
  note.tags:
    displayName: Tags
views:
  - type: table
    name: Daily notes
    filters:
      or:
        - '!file.hasProperty("tags")'
        - and:
            - '!tags.contains("daily")'
            - '!tags.contains("monthly")'
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - type
    sort:
      - property: file.name
        direction: DESC
      - property: tags
        direction: DESC
      - property: created
        direction: DESC
      - property: categories
        direction: ASC
    columnSize:
      file.name: 286
      note.tags: 91
  - type: table
    name: Monthly
    filters:
      or:
        - '!file.hasProperty("tags")'
        - and:
            - '!tags.contains("daily")'
            - '!tags.contains("monthly")'
    groupBy:
      property: category
      direction: ASC
    order:
      - start
      - file.name
      - tags
    sort:
      - property: start
        direction: ASC
      - property: file.name
        direction: DESC
      - property: tags
        direction: DESC
      - property: created
        direction: DESC
      - property: categories
        direction: ASC
    columnSize:
      note.start: 140
      file.name: 340
