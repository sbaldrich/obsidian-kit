filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("_kit")'
properties:
  file.name:
    displayName: Note
  file.ctime:
    displayName: Created
views:
  - type: table
    name: Inbox
    filters:
      and:
        - file.inFolder("inbox")
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: Needs a type
    filters:
      and:
        - '!file.inFolder("inbox")'
        - '!file.hasProperty("type")'
    order:
      - file.name
      - file.folder
      - file.ctime
    sort:
      - property: file.name
        direction: ASC
