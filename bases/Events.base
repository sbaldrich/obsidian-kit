filters:
  and:
    - category.contains("Events")
properties:
  file.name:
    displayName: Event
  start:
    displayName: Date
  participants:
    displayName: With
  project:
    displayName: Project
views:
  - type: table
    name: All Events
    order:
      - file.name
      - start
      - participants
      - project
      - type
    sort:
      - property: start
        direction: DESC
  - type: table
    name: By Project
    filters:
      or:
        - project.contains(this.file.name)
        - project == this.file.name
    order:
      - file.name
      - start
      - type
    sort: []
    columnSize:
      file.name: 292
      note.start: 137
  - type: table
    name: By Company
    filters:
      or:
        - companies.contains(this.file.name)
    order:
      - file.name
      - start
      - project
      - type
    sort:
      - property: start
        direction: DESC
