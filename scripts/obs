#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
META_DIR="$(dirname "$SCRIPT_DIR")"
META_FOLDER="$(basename "$META_DIR")"
TEMPLATER_DIR="$META_DIR/templater"

usage() {
    cat <<EOF
Usage: obs <command> [options]

Commands:
  create, c    Create a note from a registered Templater template

Options for create:
  -t, --template <name>   Template to use (partial match, case-insensitive)
  -n, --name <name>       Note name (if omitted, Templater handles naming)
  -l, --list              List available templates
  -h, --help              Show this help

Examples:
  obs create -t daily
  obs c -t event -n "Sample Event"
  obs c --template=weekly
  obs c --list
EOF
}

_list_templates() {
    while IFS= read -r -d '' file; do
        local base
        base="$(basename "$file" .md)"
        [[ "$base" == "Template - Register Template Hotkeys" ]] && continue
        grep -q '^register: false' "$file" 2>/dev/null && continue
        echo "${base#Template - }"
    done < <(find "$TEMPLATER_DIR" -name "Template - *.md" -print0 | sort -z)
}

_find_template() {
    local query
    query="$(echo "$1" | tr '[:upper:]' '[:lower:]')"
    local -a matches=()
    while IFS= read -r name; do
        [[ "$(echo "$name" | tr '[:upper:]' '[:lower:]')" == *"$query"* ]] && matches+=("$name")
    done < <(_list_templates)

    if [[ ${#matches[@]} -eq 0 ]]; then
        echo "Error: no template matching '$1'" >&2
        echo "Available:" >&2
        _list_templates >&2
        exit 1
    elif [[ ${#matches[@]} -gt 1 ]]; then
        echo "Error: '$1' is ambiguous — matches:" >&2
        printf '  %s\n' "${matches[@]}" >&2
        exit 1
    fi
    echo "${matches[0]}"
}

cmd_create() {
    local template_query="" note_name=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--template)   template_query="$2"; shift 2 ;;
            --template=*)    template_query="${1#*=}"; shift ;;
            -n|--name)       note_name="$2"; shift 2 ;;
            --name=*)        note_name="${1#*=}"; shift ;;
            -l|--list)       _list_templates; exit 0 ;;
            -h|--help)       usage; exit 0 ;;
            *)               echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
        esac
    done

    if [[ -z "$template_query" ]]; then
        echo "Error: --template / -t is required" >&2; usage >&2; exit 1
    fi

    local name
    name="$(_find_template "$template_query")"
    local template_path="$META_FOLDER/templater/Template - ${name}.md"

    if [[ -n "$note_name" ]]; then
        obsidian create name="$note_name" template="$template_path"
    else
        obsidian command id="templater-obsidian:create-${template_path}"
    fi
}

[[ $# -eq 0 ]] && { usage; exit 0; }

case "$1" in
    create|c)  shift; cmd_create "$@" ;;
    -l|--list) _list_templates ;;
    -h|--help) usage ;;
    *)         echo "Unknown command: $1" >&2; usage >&2; exit 1 ;;
esac
